# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated DocSpecs schema build artifacts (kept out of VCS; .gitkeep stays).
assets/docspecs-schema/*.docspecs-schema.yaml
# Canonical DocSpecs resolver tree written at build time (§17); not tracked.
.tom/docspecs-schema/
# Pre-generated analyzer summaries (B1) — heavy generated bundles (~3MB + ~30MB+);
# regenerated by tom_dart_editor_bundler from buildkit.yaml. Canonical committed
# home is the tom_binaries L2 layer. The .gitkeep files stay so the asset paths
# are always valid. The `**` pattern also covers the per-scope subdirectory
# bundles (e.g. assets/summaries/d4rt-flutter/packages.sum).
assets/summaries/**/*.sum

# The generated scope-init helper IS committed (re-included past tom_forge's
# repo-wide `*.g.dart` ignore): `lib/main.dart` imports it at compile time, so a
# fresh checkout must have it to build. It is tiny and regenerated deterministically
# from the committed `buildkit.yaml` by tom_dart_editor_bundler. (The heavy `.sum`
# bundles it references stay gitignored, per the policy above.)
!lib/generated/summary_scopes.g.dart
