# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated DocSpecs schema build artifacts (kept out of VCS; .gitkeep stays).
assets/docspecs-schema/*.docspecs-schema.yaml
# Canonical DocSpecs resolver tree written at build time (§17); not tracked.
.tom/docspecs-schema/
# Pre-generated analyzer summaries (B1) — heavy generated bundles (~3MB + ~30MB+);
# regenerated by tom_specs_clitool/bin/summaries.dart. Canonical committed home is
# the tom_binaries L2 layer. The .gitkeep stays so the asset path is always valid.
assets/summaries/*.sum
