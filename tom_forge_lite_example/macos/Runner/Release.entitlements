<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Not sandboxed, as tom_forge_app: the example edits the files of the
	  workspace folder named on its command line, not only files picked in an
	  open panel.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
